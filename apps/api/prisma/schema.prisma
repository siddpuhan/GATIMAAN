datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

enum TicketStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  NO_SHOW
  TRANSFERRED
}

enum DeviceType {
  GATE
  KIOSK
  DISPLAY
}

enum FootfallEventType {
  IN
  OUT
  SCAN
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
  SURGE
}

enum NotificationChannel {
  SMS
  WHATSAPP
  WEB_PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  clerkUserId  String?   @unique @map("clerk_user_id")
  email        String    @unique
  name         String?
  phone        String?   @unique
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  counterSessions CounterSession[]
  tickets         Ticket[]
  notifications   Notification[]

  @@map("users")
  @@index([email])
  @@index([phone])
  @@index([clerkUserId])
}

model Service {
  id                 String    @id @default(uuid())
  code               String    @unique
  name               String
  description        String?
  prefix             String
  avgDurationMinutes Int       @default(15) @map("avg_duration_minutes")
  priority           Int       @default(1)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tickets             Ticket[]
  predictionSnapshots PredictionSnapshot[]

  @@map("services")
  @@index([code])
  @@index([isActive])
}

model Counter {
  id            String    @id @default(uuid())
  counterNumber Int       @unique @map("counter_number")
  name          String
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  counterSessions CounterSession[]
  tickets         Ticket[]

  @@map("counters")
  @@index([counterNumber])
  @@index([isActive])
}

model CounterSession {
  id        String    @id @default(uuid())
  counterId String    @map("counter_id")
  userId    String    @map("user_id")
  openedAt  DateTime  @default(now()) @map("opened_at")
  endedAt   DateTime? @map("ended_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  counter Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("counter_sessions")
  @@index([counterId, openedAt])
  @@index([userId])
  @@index([isActive])
}

model Ticket {
  id                   String       @id @default(uuid())
  ticketNumber         String       @map("ticket_number")
  serviceId            String       @map("service_id")
  counterId            String?      @map("counter_id")
  userId               String?      @map("user_id")
  status               TicketStatus @default(WAITING)
  priority             Int          @default(1)
  qrCode               String?      @map("qr_code")
  issuedAt             DateTime     @default(now()) @map("issued_at")
  calledAt             DateTime?    @map("called_at")
  servedAt             DateTime?    @map("served_at")
  completedAt          DateTime?    @map("completed_at")
  cancelledAt          DateTime?    @map("cancelled_at")
  estimatedWaitSeconds Int?         @map("estimated_wait_seconds")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  counter       Counter?       @relation(fields: [counterId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@map("tickets")
  @@index([serviceId, status, createdAt])
  @@index([ticketNumber])
  @@index([counterId])
  @@index([userId])
  @@index([status])
}

model Device {
  id         String     @id @default(uuid())
  deviceId   String     @unique @map("device_id")
  deviceType DeviceType @map("device_type")
  name       String
  location   String?
  keyHash    String     @unique @map("key_hash")
  isActive   Boolean    @default(true) @map("is_active")
  lastSeenAt DateTime?  @map("last_seen_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  footfallEvents FootfallEvent[]

  @@map("devices")
  @@index([deviceId])
  @@index([deviceType])
  @@index([isActive])
}

model FootfallEvent {
  id            String            @id @default(uuid())
  deviceId      String            @map("device_id")
  clientEventId String            @map("client_event_id")
  eventType     FootfallEventType @map("event_type")
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, clientEventId])
  @@map("footfall_events")
  @@index([occurredAt])
  @@index([deviceId])
}

model FootfallSnapshot {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  hourOfDay    Int      @map("hour_of_day")
  dayOfWeek    Int      @map("day_of_week")
  countIn      Int      @default(0) @map("count_in")
  countOut     Int      @default(0) @map("count_out")
  netOccupancy Int      @default(0) @map("net_occupancy")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("footfall_snapshots")
  @@index([timestamp])
  @@index([hourOfDay, dayOfWeek])
}

model PredictionSnapshot {
  id                   String      @id @default(uuid())
  serviceId            String?     @map("service_id")
  timestamp            DateTime    @default(now())
  predictedWaitSeconds Int         @map("predicted_wait_seconds")
  predictedFootfall    Int         @map("predicted_footfall")
  demandLevel          DemandLevel @map("demand_level")
  recommendation       String?
  createdAt            DateTime    @default(now()) @map("created_at")

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("prediction_snapshots")
  @@index([serviceId])
  @@index([timestamp])
}

model Notification {
  id        String              @id @default(uuid())
  ticketId  String?             @map("ticket_id")
  userId    String?             @map("user_id")
  channel   NotificationChannel
  recipient String
  message   String
  status    NotificationStatus  @default(PENDING)
  read      Boolean             @default(false)
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
  @@index([ticketId])
  @@index([userId])
  @@index([status])
  @@index([read])
}
